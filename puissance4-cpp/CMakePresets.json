{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows 11 - Visual Studio 2022 (MSVC x64)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux - GCC + Ninja (Debug)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-couverture",
      "displayName": "Linux - GCC + gcov (couverture)",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage -O0 -fno-inline",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-gcc-couverture",
      "configurePreset": "linux-gcc-couverture"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-unitaires",
      "inherits": "windows-msvc",
      "filter": {
        "include": {
          "label": "unitaire"
        }
      }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-unitaires",
      "inherits": "linux-gcc",
      "filter": {
        "include": {
          "label": "unitaire"
        }
      }
    },
    {
      "name": "linux-gcc-couverture",
      "configurePreset": "linux-gcc-couverture",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-msvc",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc"
        },
        {
          "type": "build",
          "name": "windows-msvc"
        },
        {
          "type": "test",
          "name": "windows-msvc"
        }
      ]
    },
    {
      "name": "linux-gcc",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc"
        },
        {
          "type": "build",
          "name": "linux-gcc"
        },
        {
          "type": "test",
          "name": "linux-gcc"
        }
      ]
    },
    {
      "name": "linux-gcc-couverture",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc-couverture"
        },
        {
          "type": "build",
          "name": "linux-gcc-couverture"
        },
        {
          "type": "test",
          "name": "linux-gcc-couverture"
        }
      ]
    }
  ]
}
